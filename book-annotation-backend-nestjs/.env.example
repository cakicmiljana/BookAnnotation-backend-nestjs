# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Signs login tokens. Use a long random value (at least 32 characters), never this example.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Token lifetime, e.g. 1d, 12h, 3600 (seconds)
JWT_EXPIRES_IN=1d

# PostgreSQL 16 (see ../../docker-compose.yml, container postgres-dev)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=rwaapp
DATABASE_PASSWORD=rwaapp
DATABASE_NAME=test

# Password of the seeded user (npm run seed), 8-72 characters
SEED_USER_PASSWORD=reader123

# Largest file accepted by POST /api/editions, in bytes (10 MB)
UPLOAD_MAX_BYTES=10485760
