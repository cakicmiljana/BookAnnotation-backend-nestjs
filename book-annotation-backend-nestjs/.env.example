# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
PORT=3000
CORS_ORIGIN=http://localhost:4200

# PostgreSQL 16 (see ../../docker-compose.yml, container postgres-dev)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=rwaapp
DATABASE_PASSWORD=rwaapp
DATABASE_NAME=test

# Password of the seeded user (npm run seed), 8-72 characters
SEED_USER_PASSWORD=reader123
